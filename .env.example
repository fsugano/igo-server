DATABASE_URL=postgres://postgres:postgres@localhost:5432/igo
PORT=3000
# production enables Secure cookies (requires HTTPS) and requires DATABASE_URL
NODE_ENV=development
# Behind a reverse proxy / load balancer: which proxies may set X-Forwarded-For.
# Unset = trust none. "1" = one proxy in front (Fly.io, Render, Cloud Run...), or a list of proxy IPs/CIDRs.
# TRUST_PROXY=1
# Sites allowed to open the realtime connection (comma-separated). Unset = only the server's own site.
# ALLOWED_ORIGINS=https://igo.example.com
# AI chat: with a Claude API key the computer player really talks; without one it uses set phrases
# ANTHROPIC_API_KEY=sk-ant-...
# AI_CHAT_MODEL=claude-opus-5-5   # claude-haiku-5-5 is much cheaper
# AI_CHAT_MAX_PER_GAME=30
# External GTP engines such as KataGo: JSON, or the path of a JSON file (see README)
# AI_GTP_ENGINES=ai-engines.json
